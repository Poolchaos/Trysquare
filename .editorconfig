root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing spaces are not line breaks in this project's markdown, but
# hand-wrapped prose is, so leave wrapping alone.
trim_trailing_whitespace = true
max_line_length = 80
